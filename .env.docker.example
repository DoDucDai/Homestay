# LOCAL Docker demo. Copy to .env.docker; never commit the filled file.
SPRING_PROFILES_ACTIVE=dev
COOKIE_SECURE=false
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=HomestayDB
DB_USER=sa
DB_PASSWORD=replace_with_your_local_sql_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=openrouter/free
AUTH_ALLOWED_ORIGINS=
# Temporary demo mode; set true when email verification is ready.
EMAIL_VERIFICATION_ENABLED=false
MAIL_PROVIDER=brevo
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Homestay
AUTH_TOKEN_SECRET=
APP_PUBLIC_URL=http://localhost:8080
