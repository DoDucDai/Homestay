{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo No dependencies required",
  "buildCommand": "node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').writeFileSync('public/deployment.txt','Homestay demo gateway')\"",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "https://homestay-mochi-demo.onrender.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
