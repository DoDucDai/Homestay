# ================================================
# .env.example - TEMPLATE CAU HINH MOI TRUONG
# ================================================
# SAO CHEP file nay thanh ".env" roi dien gia tri cua may ban vao
# Lenh: copy .env.example .env  (Windows)
#        cp .env.example .env   (Mac/Linux)
# ================================================

# --- KET NOI SQL SERVER ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=HomestayDB
DB_USER=sa
DB_PASSWORD=your_sqlserver_password_here
DB_ENCRYPT=true
# Dev only. Production requires false and a trusted SQL Server certificate.
DB_TRUST_SERVER_CERTIFICATE=true

# --- SERVER BACKEND ---
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=dev

# Prefer frontend at http://localhost:8080/pages/login.html (same origin).
# Optional dev CORS origins, comma-separated, never '*'. Use the same hostname.
AUTH_ALLOWED_ORIGINS=
# Set true when serving through HTTPS.
COOKIE_SECURE=false

# --- ACCOUNT EMAIL (Brevo HTTPS API; never put keys in frontend) ---
# Local .env is read from the project root or backend; Render needs its own env vars.
# Set true after configuring a verified sender and both secrets below.
EMAIL_VERIFICATION_ENABLED=false
MAIL_PROVIDER=brevo
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Homestay
# Generate a random secret, at least 32 characters; keep it stable across deploys.
AUTH_TOKEN_SECRET=
APP_PUBLIC_URL=http://localhost:8080
# Giữ phòng chuyển khoản và cảnh báo yêu cầu đối soát (phút).
TRANSFER_HOLD_MINUTES=15
TRANSFER_REVIEW_WARNING_MINUTES=30
# Thông tin nhận tiền thực tế; để trống thì giao diện yêu cầu liên hệ nhân viên.
TRANSFER_BANK_NAME=
TRANSFER_ACCOUNT_NUMBER=
TRANSFER_ACCOUNT_NAME=
